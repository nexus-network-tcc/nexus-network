# Copie este arquivo para ".env" e ajuste os valores.

APP_NAME="Nexus Network"
APP_DEBUG=true
# Deixe vazio para detectar automaticamente (ex.: http://localhost/Nexus%20Network%20Company)
APP_URL=

DB_HOST=localhost
DB_PORT=3306
# nexus_network = banco real (vazio) · nexus_network_teste = banco de teste (database/teste.sql)
DB_NAME=nexus_network
DB_USER=root
DB_PASS=

# Login com Google (https://console.cloud.google.com/apis/credentials)
# URI de redirecionamento autorizada: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# E-mail: "log" grava os e-mails em storage/logs/mail.log (desenvolvimento)
#         "smtp" envia de verdade (ex.: Gmail com senha de app)
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="Nexus Network"

# Para onde vão as mensagens da página Contato (opcional, também ficam salvas no banco)
CONTACT_EMAIL=

# Verificação SSL das requisições externas (Google, Nominatim, SMTP).
# Só desative em desenvolvimento, se um antivírus intercepta HTTPS (ex.: Avast).
SSL_VERIFY=true

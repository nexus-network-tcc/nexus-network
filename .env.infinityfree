# Modelo de .env para a InfinityFree. No servidor, renomeie para ".env" (em htdocs/).
# Troque os valores marcados com <...> pelos que aparecem em "MySQL Databases" no painel.

APP_NAME="Nexus Network"
APP_DEBUG=false
# Deixe vazio para detectar automaticamente. Se o site abrir com http:// e voce quiser https://,
# preencha com a URL completa, sem barra no fim (ex.: https://nexusnetwork.infinityfreeapp.com)
APP_URL=

DB_HOST=<sqlXXX.infinityfree.com>
DB_PORT=3306
DB_NAME=<if0_XXXXXXXX_nexus>
DB_USER=<if0_XXXXXXXX>
DB_PASS=<senha-da-conta-de-hospedagem>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# A InfinityFree bloqueia o envio de e-mail pelo PHP, entao use SMTP (Gmail com senha de app)
# ou deixe "log" para gravar os e-mails em storage/logs/mail.log.
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="Nexus Network"

CONTACT_EMAIL=

SSL_VERIFY=true

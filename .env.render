# Variaveis de ambiente para cadastrar na Render (Environment). Nao e lido pelo site: serve de lista.
# Os valores entre <...> vem do painel do banco (Aiven).

APP_NAME=Nexus Network
APP_DEBUG=false
APP_URL=

DB_HOST=<host do Aiven, ex.: mysql-xxxx.aivencloud.com>
DB_PORT=<porta do Aiven, ex.: 12345>
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=<senha do Aiven>
DB_SSL=true
# Se o Aiven pedir o certificado proprio, salve-o como app/lib/db-ca.pem e use:
# DB_SSL_CA=/var/www/html/app/lib/db-ca.pem

# A Render bloqueia saida SMTP no plano gratuito; deixe "log".
MAIL_DRIVER=log
SSL_VERIFY=true
